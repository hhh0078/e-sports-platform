  "cues": [
    {
      "index": 0,
      "text": "在我的页面打开俱乐部中心，进入自己的管理控制台。",
      "start": 0,
      "end": 5.82,
      "coverage": 1
    },
    {
      "index": 1,
      "text": "加入规则与装修里，可以核对抽成、押金和团队介绍。",
      "start": 6.49675,
      "end": 13.17675,
      "coverage": 0.9048
    },
    {
      "index": 2,
      "text": "打开成员管理，搜索申请人，找到待审核的申请。",
      "start": 14.003354166666666,
      "end": 20.243354166666666,
      "coverage": 0.9474
    },
    {
      "index": 3,
      "text": "核对申请人，点击审核，填写本次处理说明。",
      "start": 20.9395625,
      "end": 26.7595625,
      "coverage": 0.9412
    },
    {
      "index": 4,
      "text": "确认处理后，申请人会成为俱乐部的认证成员。",
      "start": 27.082458333333335,
      "end": 33.28245833333333,
      "coverage": 0.8421
    },
    {
      "index": 5,
      "text": "进入团队订单，打开订单详情，查看履约进度。",
      "start": 34.154895833333335,
      "end": 39.91489583333333,
      "coverage": 1
    },
    {
      "index": 6,
      "text": "订单聊天保存沟通记录，管理员也能协助双方确认进度。",
      "start": 40.53335416666667,
      "end": 46.773354166666664,
      "coverage": 1
    },
    {
      "index": 7,
      "text": "俱乐部资金会分别展示押金、进行中佣金和待结算金额。",
      "start": 47.47477083333333,
      "end": 54.89477083333333,
      "coverage": 0.913
    }
  ],
