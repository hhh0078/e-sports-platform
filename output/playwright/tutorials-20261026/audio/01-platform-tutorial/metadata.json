  "cues": [
    {
      "index": 0,
      "text": "平台日常运营，从我的页面进入平台管理中心。",
      "start": 0,
      "end": 4,
      "coverage": 1
    },
    {
      "index": 1,
      "text": "切换统计周期，查看真实订单金额和经营趋势。",
      "start": 4,
      "end": 9.554375,
      "coverage": 0.9474
    },
    {
      "index": 2,
      "text": "打开用户管理，输入用户编号，快速定位资料。",
      "start": 9.554375,
      "end": 14.4865,
      "coverage": 1
    },
    {
      "index": 3,
      "text": "点开用户详情，核对身份和手机验证状态。",
      "start": 14.4865,
      "end": 19.1771875,
      "coverage": 1
    },
    {
      "index": 4,
      "text": "回到管理中心，进入图文审核，筛选待人工内容。",
      "start": 19.897375,
      "end": 25.137375,
      "coverage": 1
    },
    {
      "index": 5,
      "text": "打开任务，先看完整内容，再决定是否通过。",
      "start": 25.39,
      "end": 29.8335625,
      "coverage": 1
    },
    {
      "index": 6,
      "text": "确认内容符合要求后，点击通过，结果会保留记录。",
      "start": 29.8335625,
      "end": 35.5535625,
      "coverage": 1
    },
    {
      "index": 7,
      "text": "公共信息里选择顶部提示，填写玩家首页要展示的内容。",
      "start": 36.29327083333333,
      "end": 41.97327083333333,
      "coverage": 1
    },
    {
      "index": 8,
      "text": "保存公共信息后，返回玩家首页，查看提示是否生效。",
      "start": 42.663354166666664,
      "end": 47.78335416666667,
      "coverage": 1
    }
  ],
