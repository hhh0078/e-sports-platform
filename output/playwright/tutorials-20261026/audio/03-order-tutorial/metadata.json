  "cues": [
    {
      "index": 0,
      "text": "玩家先查看服务详情，确认价格、介绍和服务方。",
      "start": 0,
      "end": 4.82,
      "coverage": 1
    },
    {
      "index": 1,
      "text": "填写区服、预约时间和验收标准，双方更容易对齐预期。",
      "start": 5.822208333333333,
      "end": 11.862208333333333,
      "coverage": 0.9545
    },
    {
      "index": 2,
      "text": "核对金额后确认下单，系统会生成一笔待付款订单。",
      "start": 13.246708333333334,
      "end": 18.106708333333334,
      "coverage": 0.9048
    },
    {
      "index": 3,
      "text": "订单内选择支付方式。这次演示使用本地测试支付。",
      "start": 18.996145833333333,
      "end": 24.456145833333334,
      "coverage": 0.9524
    },
    {
      "index": 4,
      "text": "确认支付后，订单进入待接单状态，正式交易以微信结果为准。",
      "start": 25.258541666666666,
      "end": 31.698541666666667,
      "coverage": 0.96
    },
    {
      "index": 5,
      "text": "打开订单聊天，把集合时间和服务需求留在订单里。",
      "start": 32.754,
      "end": 38.274,
      "coverage": 1
    },
    {
      "index": 6,
      "text": "切到接单者视角，核对需求后，点击接受订单。",
      "start": 39.636604166666665,
      "end": 45.596604166666665,
      "coverage": 0.9444
    },
    {
      "index": 7,
      "text": "双方确认后，点击开始服务，订单进度同步更新。",
      "start": 47.116770833333334,
      "end": 53.19677083333333,
      "coverage": 1
    },
    {
      "index": 8,
      "text": "服务过程中在订单聊天同步进度，方便双方核对。",
      "start": 54.72666666666667,
      "end": 60.06666666666667,
      "coverage": 0.95
    },
    {
      "index": 9,
      "text": "完成服务后提交交付，写清完成内容，等待玩家验收。",
      "start": 61.52139583333334,
      "end": 68.14139583333333,
      "coverage": 1
    },
    {
      "index": 10,
      "text": "玩家核对交付说明，确认符合约定后，验收并完成。",
      "start": 69.776875,
      "end": 75.516875,
      "coverage": 1
    },
    {
      "index": 11,
      "text": "服务收入先进入结算中，保留七天售后期，再按规则转为可提现。",
      "start": 77.67033333333333,
      "end": 85.23033333333333,
      "coverage": 0.9615
    }
  ],
