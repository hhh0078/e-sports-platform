# 文件作用：本地 API 配置示例；复制为 .env 后由 scripts/dev-start.sh 加载，不提交真实密钥。
APP_ENV=development
DEV_MODE=true
ADDR=127.0.0.1:8090
DATABASE_URL='postgres://postgres:postgres@127.0.0.1:5432/jijie_dev?sslmode=disable'
REDIS_ADDR=127.0.0.1:56379
REDIS_PASSWORD=''
REDIS_PREFIX=jijie:

# 真实微信接入：正式部署必须 APP_ENV=production、DEV_MODE=false，详见 docs/WECHAT_SETUP.md。
WECHAT_APP_ID=''
WECHAT_APP_SECRET=''
# 微信消息推送独立回调配置；与AppSecret不同。留空不启用回调，订阅发送仍按用户明确授权处理。
# 微信后台消息推送URL：https://你的域名/api/wechat/messages；本功能支持XML及安全模式AES。
WECHAT_MESSAGE_TOKEN=''
WECHAT_MESSAGE_AES_KEY=''
WECHAT_PAY_MCH_ID=''
WECHAT_PAY_SERIAL=''
WECHAT_PAY_PUBLIC_KEY_ID=''
WECHAT_PAY_API_V3_KEY=''
WECHAT_PAY_PRIVATE_KEY_PATH=''
WECHAT_PAY_PUBLIC_KEY_PATH=''
WECHAT_PAY_NOTIFY_URL=''
WECHAT_PAY_REFUND_NOTIFY_URL=''
