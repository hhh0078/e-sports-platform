# 文件作用：开机电竞服务器配置模板；复制为 .env、填写后 chmod 600，绝不提交真实配置。
IMAGE_TAG=local
API_PORT=18090
POSTGRES_DB=jijie
POSTGRES_USER=jijie
# 密码使用 openssl rand -hex 24 生成，避免 URI 特殊字符。
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX
WECHAT_APP_ID=YOUR_MINIPROGRAM_APP_ID
WECHAT_APP_SECRET=YOUR_MINIPROGRAM_APP_SECRET
# 可选：与微信后台“消息推送”设置一致的独立Token、43字符EncodingAESKey；不填真实值到源码。
# 回调URL：https://game.ai.58it.cn/api/wechat/messages，数据格式XML；配置AES后仅接受加密消息。
WECHAT_MESSAGE_TOKEN=
WECHAT_MESSAGE_AES_KEY=
# openssl rand -base64 32；必须与数据库一起备份，丢失后无法解密已保存的支付配置。
CONFIG_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
# 仅首次管理员配置，填写微信官方确认的本人 OpenID，登录赋权后清空并重建容器。
BOOTSTRAP_ADMIN_OPENID=
